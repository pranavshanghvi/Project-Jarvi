{
  "expo": {
    "name": "Jarvi",
    "slug": "jarvi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pranavshanghvi.jarvi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "9ZZYSBC8SD"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "jarvi",
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Jarvi reads the calories you burn (from Apple Watch) to compare them with what you eat.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Jarvi looks in your photos for food pictures taken with your smart glasses.",
          "savePhotosPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Jarvi uses the camera to photograph your food.",
          "photosPermission": "Jarvi lets you pick a food photo from your library."
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "./plugins/withSpaceSafeBuild"
    ]
  }
}
